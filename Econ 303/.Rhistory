# Parameters
n <- 95                # Number of trials
p <- 14 / 15           # Probability that a wait time exceeds 1 minute
mu <- n * p            # Mean of the binomial distribution
sigma <- sqrt(n * p * (1 - p))  # Standard deviation of the binomial distribution
# Apply continuity correction (probability that Y >= 92 is approximated as P(Y >= 91.5))
z <- (91.5 - mu) / sigma
# Find the cumulative probability for Z
probability <- 1 - pnorm(z)
# Round to 2 decimal places
round(probability, 2)
# Parameters
target_sum <- 325           # Target sum
expected_roll <- 3.5        # Expected value of each die roll
n_min <- ceiling(target_sum / expected_roll)  # Minimum number of rolls required
# Standard deviation of each die roll
sd_roll <- sqrt((35/12))  # Variance of a single die roll (variance of uniform distribution on [1,6])
# Approximate the total sum after n rolls as a normal distribution
# Mean of total sum after n rolls
mu_sum <- expected_roll * n_min
# Standard deviation of total sum after n rolls
sd_sum <- sqrt(n_min) * sd_roll
# We want the probability that the number of rolls needed is at least 86
# Apply the normal approximation to the number of rolls, which is normally distributed
z <- (325 - mu_sum) / sd_sum
# Find the probability from the standard normal distribution
probability <- pnorm(z)
# Round the result to two decimal places
round(1 - probability, 2)
# Parameters
target_sum <- 325           # Target sum
expected_roll <- 3.5        # Expected value of each die roll
n_min <- ceiling(target_sum / expected_roll)  # Minimum number of rolls required
# Standard deviation of each die roll
sd_roll <- sqrt((35/12))  # Variance of a single die roll (variance of uniform distribution on [1,6])
# Approximate the total sum after n rolls as a normal distribution
# Mean of total sum after n rolls
mu_sum <- expected_roll * n_min
# Standard deviation of total sum after n rolls
sd_sum <- sqrt(n_min) * sd_roll
# We want the probability that the number of rolls needed is at least 86
# Apply the normal approximation to the number of rolls, which is normally distributed
z <- (325 - mu_sum) / sd_sum
# Find the probability from the standard normal distribution
probability <- pnorm(z)
1-probability
# Function to simulate the rolling process
simulate_rolls <- function(target_sum = 325) {
total_sum <- 0
num_rolls <- 0
# Keep rolling until the sum exceeds the target
while (total_sum <= target_sum) {
num_rolls <- num_rolls + 1
total_sum <- total_sum + sample(1:6, 1, replace = TRUE)  # Roll a fair 6-sided die
}
return(num_rolls)
}
# Run the simulation 10000 times (for example)
num_simulations <- 10000
rolls_needed <- replicate(num_simulations, simulate_rolls())
# Calculate the probability that at least 86 rolls are needed
probability_at_least_86 <- mean(rolls_needed >= 86)
# Print the result
print(probability_at_least_86)
